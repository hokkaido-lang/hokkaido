extern fn printf(fmt: string, ...) -> int

// Inline pair: (suc (suc zero) , suc zero) = (2, 1)
let p1: cubical = "data Nat = | zero : Nat | suc : Nat -> Nat\ndef main : Nat * Nat = (suc (suc zero) , suc zero)"

// Pair from .cub file
let p2: cubical = "../test/cubical_pair.cub"

// Nested pair: (1, (2, 0))
let p3: cubical = "data Nat = | zero : Nat | suc : Nat -> Nat\ndef main : Nat * (Nat * Nat) = (suc zero , (suc (suc zero) , zero))"

// Triple nested: ((1, 2), (3, 4))
let p4: cubical = "data Nat = | zero : Nat | suc : Nat -> Nat\ndef main : (Nat * Nat) * (Nat * Nat) = ((suc zero , suc (suc zero)) , (suc (suc (suc zero)) , suc (suc (suc (suc zero)))))"

fn main() -> int {
    printf("all pair tests passed (check IR for struct constants)\n")
    0
}
