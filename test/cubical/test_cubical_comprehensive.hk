extern fn printf(fmt: string, ...) -> int

// ── 1. Nat (int64) ──────────────────────────────────────────
let n: cubical = "data Nat = | zero : Nat | suc : Nat -> Nat\ndef main : Nat = suc (suc (suc (suc (suc zero))))"

// ── 2. Bool (int8) ──────────────────────────────────────────
let t: cubical = "data Bool = | true : Bool | false : Bool\ndef main : Bool = true"
let f: cubical = "data Bool = | false : Bool | true : Bool\ndef main : Bool = false"
let b2: cubical = "inputs/cubical_bool.cub"

// ── 3. Pair (LLVM struct) ───────────────────────────────────
let pair: cubical = "data Nat = | zero : Nat | suc : Nat -> Nat\ndef main : Nat * Nat = (suc (suc zero) , suc zero)"
let pair_file: cubical = "inputs/cubical_pair.cub"

// ── 4. Nested pair ──────────────────────────────────────────
let nested: cubical = "data Nat = | zero : Nat | suc : Nat -> Nat\ndef main : Nat * (Nat * Nat) = (suc zero , (suc (suc zero) , suc (suc (suc zero))))"

// ── 5. Cons-chain (LLVM array) ──────────────────────────────
let list: cubical = "data Nat  = | zero : Nat | suc : Nat -> Nat\ndata List = | nil : List | cons : Nat -> List -> List\ndef main : List = cons (suc zero) (cons (suc (suc zero)) nil)"

// ── 6. String fallback (constructor / universe) ──────────────
let flag: cubical = "def main : U1 = U0"
let constructor: cubical = "data Nat = | zero : Nat | suc : Nat -> Nat\ndef main : Nat = zero"

fn main() -> int {
    printf("n = %ld (expected 5)\n", n)
    printf("t = %d (expected 1)\n", t)
    printf("f = %d (expected 0)\n", f)
    printf("flag = %s\n", flag)
    0
}
