// Phase 3 Tests: Memory & Data Structures
// =========================================

// --- 1. Array-to-slice conversion at function call ---
fn sum_slice(x: int64[]) -> int64 {
    return x[0] + x[1]
}

fn test_array_to_slice() -> int64 {
    let arr: int64[2] = [100, 200]
    return sum_slice(arr)
}

// --- 2. Slice subscript read/write via array-to-slice ---
fn double_first(s: int64[]) -> int64 {
    let r: int64 = s[0] * 2
    s[0] = r
    return r
}

fn test_slice_subscript() -> int64 {
    let arr: int64[3] = [10, 20, 30]
    return double_first(arr)
}

// --- 3. Slice with different element types ---
fn sum_int_slice(s: int[]) -> int {
    return s[0] + s[1]
}

fn test_slice_int() -> int {
    let arr: int[2] = [5, 6]
    return sum_int_slice(arr)
}

// --- 4. Multiple slice parameters ---
fn sum_two_slices(a: int64[], b: int64[]) -> int64 {
    return a[0] + b[0]
}

fn test_multi_slice() -> int64 {
    let x: int64[1] = [100]
    let y: int64[1] = [200]
    return sum_two_slices(x, y)
}

// --- 5. Positional struct constructors ---
struct PosPoint { a: int64  b: int64 }

fn test_positional_ctor() -> int64 {
    let p: PosPoint = PosPoint { 10, 20 }
    return p.a + p.b
}

// --- 6. Named struct constructors ---
struct NamedPoint { x: int64  y: int64 }

fn test_named_ctor() -> int64 {
    let p: NamedPoint = NamedPoint { x: 30, y: 40 }
    return p.x + p.y
}

// --- 7. Enum variant positional constructor ---
enum Opt {
    Some { val: int64 }
    None
}

fn test_enum_ctor() -> int64 {
    let v: Opt = Opt::Some { 42 }
    return match v {
        Opt::Some { val: n } => n
        Opt::None => 0
    }
}

// --- 8. Enum variant named constructor ---
fn test_enum_named_ctor() -> int64 {
    let v: Opt = Opt::Some { val: 99 }
    return match v {
        Opt::Some { val: n } => n
        Opt::None => 0
    }
}

// --- 9. extern fn malloc/free with raw pointers ---
extern fn malloc(size: int64) -> int8*
extern fn free(ptr: int8*) -> void

fn test_malloc_free() -> int64 {
    let ptr: int8* = malloc(8)
    let p: int64* = ptr
    p[0] = 42
    let r: int64 = p[0]
    free(ptr)
    return r
}

fn main() -> int {
    let a: int64 = test_array_to_slice()
    let b: int64 = test_slice_subscript()
    let c: int = test_slice_int()
    let d: int64 = test_multi_slice()
    let e: int64 = test_positional_ctor()
    let f: int64 = test_named_ctor()
    let g: int64 = test_enum_ctor()
    let h: int64 = test_enum_named_ctor()
    let i: int64 = test_malloc_free()
    return 0
}
