extern fn printf(fmt: string, ...) -> int

// Cubical Bool → int8 (1 for True, 0 for False)
let b1: cubical = "data Bool = | true : Bool | false : Bool\ndef main : Bool = true"
let b2: cubical = "data Bool = | false : Bool | true : Bool\ndef main : Bool = false"

fn main() -> int {
    printf("b1 = %d (expected 1)\n", b1)
    printf("b2 = %d (expected 0)\n", b2)
    0
}
