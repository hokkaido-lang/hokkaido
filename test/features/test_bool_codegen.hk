extern fn printf(fmt: string, ...) -> int

fn is_even(x: int) -> bool { return x % 2 == 0 }
fn is_odd(x: int) -> bool { return x % 2 != 0 }
fn is_positive(x: int) -> bool { return x > 0 }
fn is_negative(x: int) -> bool { return x < 0 }
fn apply_bool(f: fn(int) -> bool, x: int) -> bool { return f(x) }

fn main() -> int {
    let pass: int = 1

    // Test: comparison via bool intermediate
    let a: bool = is_even(4)
    let ia: int = 0
    if a { ia = 1 }
    if ia != 1 { pass = 0 }
    printf("is_even(4)=%ld (expect 1)\n", ia)

    let b: bool = is_even(3)
    let ib: int = 0
    if b { ib = 1 }
    if ib != 0 { pass = 0 }
    printf("is_even(3)=%ld (expect 0)\n", ib)

    let c: bool = is_odd(7)
    let ic: int = 0
    if c { ic = 1 }
    if ic != 1 { pass = 0 }
    printf("is_odd(7)=%ld (expect 1)\n", ic)

    let d: bool = is_positive(5)
    let id: int = 0
    if d { id = 1 }
    if id != 1 { pass = 0 }
    printf("is_positive(5)=%ld (expect 1)\n", id)

    let e: bool = is_negative(-3)
    let ie: int = 0
    if e { ie = 1 }
    if ie != 1 { pass = 0 }
    printf("is_negative(-3)=%ld (expect 1)\n", ie)

    // Test: comparison via function pointer
    let f: bool = apply_bool(&is_even, 6)
    let if_: int = 0
    if f { if_ = 1 }
    if if_ != 1 { pass = 0 }
    printf("apply(is_even,6)=%ld (expect 1)\n", if_)

    let g: bool = apply_bool(&is_positive, -1)
    let ig: int = 0
    if g { ig = 1 }
    if ig != 0 { pass = 0 }
    printf("apply(is_positive,-1)=%ld (expect 0)\n", ig)

    // Test: direct comparison in if (regression check)
    let ih: int = 0
    if 5 > 3 { ih = 1 }
    if ih != 1 { pass = 0 }
    printf("5>3 direct=%ld (expect 1)\n", ih)

    let ii: int = 0
    if 2 < 1 { ii = 1 }
    if ii != 0 { pass = 0 }
    printf("2<1 direct=%ld (expect 0)\n", ii)

    if pass { printf("ALL PASS\n") } else { printf("SOME FAILED\n") }
    return 0
}
