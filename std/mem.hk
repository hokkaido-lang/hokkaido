package std

// Pure-memory operations (no libc dependency, works in WASM freestanding)

pub fn mem_copy(dst: int8*, src: int8*, n: int64) -> void {
    for let i: int64 = 0; i < n; i = i + 1 {
        dst[i] = src[i]
    }
    return
}

pub fn mem_set(ptr: int8*, val: int8, n: int64) -> void {
    for let i: int64 = 0; i < n; i = i + 1 {
        ptr[i] = val
    }
    return
}

pub fn mem_zero(ptr: int8*, n: int64) -> void {
    for let i: int64 = 0; i < n; i = i + 1 {
        ptr[i] = 0
    }
    return
}

pub fn mem_eq(a: int8*, b: int8*, n: int64) -> bool {
    for let i: int64 = 0; i < n; i = i + 1 {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

pub fn mem_swap(a: int8*, b: int8*, n: int64) -> void {
    for let i: int64 = 0; i < n; i = i + 1 {
        let tmp: int8 = a[i]
        a[i] = b[i]
        b[i] = tmp
    }
    return
}

pub fn mem_find(haystack: int8*, needle: int8*, h_len: int64, n_len: int64) -> int64 {
    if n_len == 0 {
        return 0
    }
    if n_len > h_len {
        return -1
    }
    let limit: int64 = h_len - n_len
    for let i: int64 = 0; i <= limit; i = i + 1 {
        if mem_eq(haystack + i, needle, n_len) {
            return i
        }
    }
    return -1
}

pub fn mem_contains(haystack: int8*, needle: int8*, h_len: int64, n_len: int64) -> bool {
    return mem_find(haystack, needle, h_len, n_len) != -1
}
