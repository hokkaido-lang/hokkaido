package std

extern fn memcpy(dst: int8*, src: int8*, n: int64) -> int8*
extern fn memset(ptr: int8*, val: int8, n: int64) -> int8*

pub fn mem_copy(dst: int8*, src: int8*, n: int64) -> void {
    memcpy(dst, src, n)
    return
}

pub fn mem_set(ptr: int8*, val: int8, n: int64) -> void {
    memset(ptr, val, n)
    return
}

pub fn mem_zero(ptr: int8*, n: int64) -> void {
    memset(ptr, 0, n)
    return
}

pub fn mem_eq(a: int8*, b: int8*, n: int64) -> bool {
    for let i: int64 = 0; i < n; i = i + 1 {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

pub fn mem_swap(a: int8*, b: int8*, n: int64) -> void {
    for let i: int64 = 0; i < n; i = i + 1 {
        let tmp: int8 = a[i]
        a[i] = b[i]
        b[i] = tmp
    }
    return
}
