package std

pub fn mem_copy(dst: int8*, src: int8*, n: int64) -> void {
    for let i: int64 = 0; i < n; i = i + 1 {
        dst[i] = src[i]
    }
    return
}

pub fn mem_set(ptr: int8*, val: int8, n: int64) -> void {
    for let i: int64 = 0; i < n; i = i + 1 {
        ptr[i] = val
    }
    return
}

pub fn mem_zero(ptr: int8*, n: int64) -> void {
    mem_set(ptr, 0, n)
    return
}

pub fn mem_eq(a: int8*, b: int8*, n: int64) -> bool {
    for let i: int64 = 0; i < n; i = i + 1 {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

pub fn mem_swap(a: int8*, b: int8*, n: int64) -> void {
    for let i: int64 = 0; i < n; i = i + 1 {
        let tmp: int8 = a[i]
        a[i] = b[i]
        b[i] = tmp
    }
    return
}

pub fn mem_find_byte(haystack: int8*, needle: int8, h_len: int64) -> int64 {
    for let i: int64 = 0; i < h_len; i = i + 1 {
        if haystack[i] == needle {
            return i
        }
    }
    return -1
}
