package std

pub fn twice(f: fn(int) -> int, x: int) -> int {
    return apply_n(f, 2, x)
}

pub fn thrice(f: fn(int) -> int, x: int) -> int {
    return apply_n(f, 3, x)
}

pub fn compose_apply(f: fn(int) -> int, g: fn(int) -> int, x: int) -> int {
    return f(g(x))
}

pub fn apply_n(f: fn(int) -> int, n: int, x: int) -> int {
    let acc: int = x
    let i: int = 0
    while i < n {
        acc = f(acc)
        i = i + 1
    }
    return acc
}

pub fn fold_int(f: fn(int, int) -> int, init: int, arr: int[], len: int) -> int {
    let acc: int = init
    let i: int = 0
    while i < len {
        acc = f(acc, arr[i])
        i = i + 1
    }
    return acc
}

pub fn reduce_int(f: fn(int, int) -> int, arr: int[], len: int) -> int {
    if len <= 0 {
        return 0
    }
    let acc: int = arr[0]
    let i: int = 1
    while i < len {
        acc = f(acc, arr[i])
        i = i + 1
    }
    return acc
}
