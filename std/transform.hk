package std

pub fn map_int_into(f: fn(int) -> int, src: int[], dst: int[], len: int) -> void {
    let i: int = 0
    while i < len {
        dst[i] = f(src[i])
        i = i + 1
    }
    return
}

pub fn filter_int(f: fn(int) -> bool, arr: int[], len: int, out: int[]) -> int {
    let j: int = 0
    let i: int = 0
    while i < len {
        if f(arr[i]) {
            out[j] = arr[i]
            j = j + 1
        }
        i = i + 1
    }
    return j
}

pub fn sum_int(arr: int[], len: int) -> int {
    let s: int = 0
    let i: int = 0
    while i < len {
        s = s + arr[i]
        i = i + 1
    }
    return s
}

pub fn min_int(arr: int[], len: int) -> int {
    if len <= 0 {
        return 0
    }
    let m: int = arr[0]
    let i: int = 1
    while i < len {
        let v: int = arr[i]
        if v < m {
            m = v
        }
        i = i + 1
    }
    return m
}

pub fn max_int(arr: int[], len: int) -> int {
    if len <= 0 {
        return 0
    }
    let m: int = arr[0]
    let i: int = 1
    while i < len {
        let v: int = arr[i]
        if v > m {
            m = v
        }
        i = i + 1
    }
    return m
}
