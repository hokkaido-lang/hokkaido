package std

pub fn any_int(f: fn(int) -> bool, arr: int[], len: int) -> bool {
    let i: int = 0
    while i < len {
        if f(arr[i]) {
            return true
        }
        i = i + 1
    }
    return false
}

pub fn all_int(f: fn(int) -> bool, arr: int[], len: int) -> bool {
    let i: int = 0
    while i < len {
        if f(arr[i]) {
            i = i + 1
        } else {
            return false
        }
    }
    return true
}

pub fn find_int(f: fn(int) -> bool, arr: int[], len: int) -> int {
    let i: int = 0
    while i < len {
        if f(arr[i]) {
            return i
        }
        i = i + 1
    }
    return -1
}

pub fn count_int(f: fn(int) -> bool, arr: int[], len: int) -> int {
    let cnt: int = 0
    let i: int = 0
    while i < len {
        if f(arr[i]) {
            cnt = cnt + 1
        }
        i = i + 1
    }
    return cnt
}
